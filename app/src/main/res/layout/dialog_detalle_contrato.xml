<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#D5DBDB"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detalle del Contrato"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#2C3E50"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CÓDIGO DE CONTRATO"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#95A5A6"
        android:letterSpacing="0.05"/>
    <TextView
        android:id="@+id/tvBsCodigoContrato"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="---"
        android:textSize="15sp"
        android:textColor="#34495E"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FECHA DE INICIO"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#95A5A6"
        android:letterSpacing="0.05"/>
    <TextView
        android:id="@+id/tvBsFechaInicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--/--/----"
        android:textSize="15sp"
        android:textColor="#34495E"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FECHA DE FINALIZACIÓN"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#95A5A6"
        android:letterSpacing="0.05"/>
    <TextView
        android:id="@+id/tvBsFechaFin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="--/--/----"
        android:textSize="15sp"
        android:textColor="#34495E"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MONTO ACORDADO"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#95A5A6"
        android:letterSpacing="0.05"/>
    <TextView
        android:id="@+id/tvBsMonto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="$0.00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVerPagos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="VER PAGOS"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#8E44AD"
        app:cornerRadius="8dp" />

</LinearLayout>